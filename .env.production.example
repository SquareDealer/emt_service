# Production env. Copy to .env.production, fill in, keep it OUT of git.
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# DATABASE_URL and CORS_ORIGIN are NOT set here — compose composes them from
# POSTGRES_PASSWORD and DOMAIN (single source of truth).

# Public domain — DNS A-record must point at this VPS. Caddy issues a Let's
# Encrypt cert for it automatically. For a local HTTP-only smoke test use: DOMAIN=:80
DOMAIN=crm.example.com

# Postgres password (used by the db container and composed into DATABASE_URL).
POSTGRES_PASSWORD=change-me-strong

# Auth — REQUIRED. Long random value, e.g.  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

NODE_ENV=production

# Owner account, seeded once on first boot. The app REFUSES the default "owner"
# password when NODE_ENV=production — set a strong one.
SEED_OWNER_LOGIN=owner
SEED_OWNER_PASSWORD=change-me-strong
SEED_OWNER_NAME=Владелец
SEED_LABOR_RATE=2000
