# Frontend env (Vite, build-time). Copy to .env for local dev.
#
# Leave empty (or set to /api) for the default: the SPA calls /api/* and the Vite
# dev proxy forwards to the backend on :3000. Set an absolute URL only to target a
# separate API host, e.g. VITE_API_URL=https://api.example.com/api
VITE_API_URL=/api
