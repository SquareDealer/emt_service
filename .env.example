# Backend env
NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://crm:crm@localhost:5544/tatarin_crm

# Auth — REQUIRED. App refuses to boot without JWT_SECRET. Use a long random value.
JWT_SECRET=replace-me-strong
JWT_EXPIRES_IN=12h

# Seed owner account — set a strong password before any production deploy.
# In production the app refuses to seed with the default "owner".
SEED_OWNER_LOGIN=owner
SEED_OWNER_PASSWORD=CHANGE_ME_BEFORE_PROD
SEED_OWNER_NAME=Владелец
SEED_LABOR_RATE=2000
